meta {
  name: Delete one of my links and its clicks
  type: http
  seq: 4
  tags: [
    links
  ]
}

delete {
  url: {{baseUrl}}/links/:id
  body: none
  auth: inherit
}

params:path {
  id: {{linkId}}
}

example {
  name: 204 Response
